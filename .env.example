PORT=4000
NODE_ENV=production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:4000
DB_PATH=./server/data.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# SMTP is required for the contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
