# Required: generate a unique random secret with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES=7d

PORT=4000
CORS_ORIGIN=http://localhost:4000
DB_PATH=./server/data.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Required before running npm run seed. Use a unique password of 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-12-chars-minimum

# Required to deliver contact / purchase enquiry forms
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
